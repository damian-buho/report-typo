{
  "name": "report-typo",
  "version": "0.2.8",
  "type": "module",
  "description": "Ctrl+Enter typo reporting for any website",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./en": {
      "types": "./dist/index.d.ts",
      "import": "./dist/en.js"
    },
    "./es": {
      "types": "./dist/index.d.ts",
      "import": "./dist/es.js"
    },
    "./uk": {
      "types": "./dist/index.d.ts",
      "import": "./dist/uk.js"
    }
  },
  "files": [
    "dist/"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsup && tsc --project tsconfig.build.json",
    "build:test": "TEST_BUILD=1 tsup",
    "pretest": "npm run build:test",
    "test": "node --test 'dist/test/*.test.js'",
    "posttest": "npm run build && size-limit",
    "typecheck": "tsc --noEmit",
    "check-size": "size-limit",
    "prepublishOnly": "npm run build",
    "lint": "eslint ./",
    "mutate": "stryker run --concurrency 1",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'tests/**/*.ts'"
  },
  "keywords": [
    "browser",
    "copyediting",
    "crowdsourcing",
    "dialog",
    "feedback-widget",
    "i18n",
    "javascript",
    "keyboard-shortcuts",
    "orphus",
    "proofreading",
    "reporting-api",
    "shadow-dom",
    "spellcheck",
    "typo",
    "user-feedback",
    "vanilla-js",
    "webhook"
  ],
  "author": {
    "email": "damian.buho@proton.me",
    "name": "Damián Búho",
    "url": "https://dbuho.me"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:damian-buho/report-typo.git"
  },
  "bugs": {
    "url": "https://github.com/damian-buho/report-typo/issues"
  },
  "homepage": "https://github.com/damian-buho/report-typo#readme",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@size-limit/preset-small-lib": "14.3.0",
    "@stryker-mutator/core": "10.1.1",
    "@types/eslint": "9.6.1",
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-n": "18.5.0",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-tsdoc": "0.5.4",
    "eslint-plugin-unicorn": "79.0.0",
    "globals": "17.13.0",
    "happy-dom": "21.0.4",
    "prettier": "3.9.10",
    "size-limit": "14.3.0",
    "tsup": "9.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "yaml": "2.9.1"
  },
  "prettier": {
    "arrowParens": "avoid",
    "bracketSpacing": true,
    "printWidth": 100,
    "quoteProps": "as-needed",
    "semi": false,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "none",
    "useTabs": false
  },
  "overrides": {
    "esbuild": "0.28.2",
    "globals": "$globals",
    "qs": "6.16.1"
  },
  "size-limit": [
    {
      "path": "./dist/index.js",
      "limit": "3 kB",
      "gzip": true
    }
  ],
  "maintainers": [
    {
      "email": "damian.buho@proton.me",
      "name": "Damián Búho",
      "url": "https://dbuho.me"
    }
  ]
}
